# Copy to .env and fill in. Required for self-hosting outside Manus's platform.

# MySQL connection string. Needed for inventory persistence, snapshots,
# the admin Claude-key setting, and the manual unit editor.
DATABASE_URL=mysql://user:password@localhost:3306/openhouse_inventory

# OCR (unit extraction from uploaded images/PDFs) is LLM-based. Set a real
# Anthropic API key here to enable it with zero other setup — this is read
# directly, no database required. (Alternatively an admin can paste a key
# into Admin Settings once the app is running and DATABASE_URL is set;
# that DB-stored key takes precedence over this one if both are set.)
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the Claude model used for OCR extraction.
# ANTHROPIC_MODEL=claude-sonnet-5

# Session/cookie signing secret. Use any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# There is no login on self-hosted deployments -- every visitor is
# auto-authenticated as a single admin user (see server/_core/context.ts).
# This password is the only real gate left: it confirms destructive/admin
# actions (reset inventory, manual edits, setting the Claude key).
# Defaults to "admin123" if unset -- change this.
INVENTORY_RESET_PASSWORD=change-me

# Server port (auto-increments if busy). Defaults to 3000.
# PORT=3000

# --- Manus-hosting-only, leave unset when self-hosting ---
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# VITE_APP_ID=
